PORT=3333 #Port who server will run
DATABASE_URL="file:./database.db" #URL to storage the SQLite file
CLIENTS_URL= #URL of clients, separe using comma, ex: http://localhost:5732,http://localhost:8080
PRINTER_HOST= #IP of the network thermal printer, leave empty to turn printing off
PRINTER_PORT=9100 #RAW printing port of the printer
PRINTER_COLUMNS=42 #Characters per line of the ticket (42 or 48 on 80mm printers)
PRINTER_CODEPAGE=850 #Use ascii to print without accents if they come out wrong