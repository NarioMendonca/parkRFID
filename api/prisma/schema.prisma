// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"

  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "sqlite"
}

model SessionsGroup {
  id                     String @id @default(uuid())
  responsibleCpf         String
  responsiblePhoneNumber String

  session Sessions[]
}

enum Status {
  OPEN
  CLOSED
}

enum SessionType {
  NORMAL
  KID
}

model Bracelets {
  id        String   @id @default(uuid())
  uid_rfid  String   @unique
  createdAt DateTime @default(now())
}

model Sessions {
  id              String      @id @default(uuid())
  braceletId      String
  checkoutDate    DateTime?
  checkinDate     DateTime    @default(now())
  status          Status      @default(OPEN)
  total           Decimal     @default("0")
  sessionType     SessionType @default(NORMAL)
  sessionsGroupId String

  sessionGroup SessionsGroup @relation(fields: [sessionsGroupId], references: [id])

  orders Orders[]

  @@unique([braceletId], where: { status: "OPEN" })
}

model MenuItems {
  id          String  @id @default(uuid())
  name        String
  category    String
  price       Decimal
  isAvaliable Boolean

  orderItems OrderItems[]
}

model Orders {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  sessionId String

  session    Sessions     @relation(fields: [sessionId], references: [id])
  orderItems OrderItems[]
}

model OrderItems {
  id         String @id @default(uuid())
  amount     Int
  menuItemId String
  ordersId   String

  menuItems MenuItems @relation(fields: [menuItemId], references: [id])
  orders    Orders    @relation(fields: [ordersId], references: [id])
}
