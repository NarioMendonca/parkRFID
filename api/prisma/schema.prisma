// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"

  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "sqlite"
}

model SessionsGroup {
  id                     String    @id @default(uuid())
  responsibleCpf         String
  responsiblePhoneNumber String
  balance                Decimal   @default("0")
  createdAt              DateTime  @default(now())
  checkoutDt             DateTime?
  status                 Status    @default(OPEN)

  session Sessions[]
  order   Orders[]
}

model Bracelets {
  id        String   @id @default(uuid())
  uid_rfid  String   @unique
  createdAt DateTime @default(now())
}

enum Status {
  OPEN
  CLOSED
}

enum SessionRole {
  NORMAL
  KID
}

model Sessions {
  id             String      @id @default(uuid())
  braceletId     String
  checkoutDate   DateTime?
  checkinDate    DateTime    @default(now())
  status         Status      @default(OPEN)
  total          Decimal     @default("0")
  sessionType    SessionRole @default(NORMAL)
  sessionGroupId String

  sessionGroup SessionsGroup @relation(fields: [sessionGroupId], references: [id])

  order   Orders[]
  payment Payments[]

  @@unique([braceletId], where: { status: "OPEN" })
}

model MenuItems {
  id          String  @id @default(uuid())
  name        String
  category    String
  price       Decimal
  isAvaliable Boolean @default(true)
  isActive    Boolean @default(true)

  orderItem OrderItems[]
}

enum SessionType {
  SESSION
  SESSION_GROUP
}

model Orders {
  id             String      @id @default(uuid())
  createdAt      DateTime    @default(now())
  sessionId      String?
  sessionGroupId String?
  createdBy      SessionType
  tableNumber    String?

  session      Sessions?      @relation(fields: [sessionId], references: [id])
  sessionGroup SessionsGroup? @relation(fields: [sessionGroupId], references: [id])
  orderItem    OrderItems[]
  printJob     PrintJobs[]
}

enum PrintStatus {
  PENDING
  PRINTING
  PRINTED
  FAILED
}

// Queue of tickets to print, one job per order, handled oldest first
model PrintJobs {
  id            String      @id @default(uuid())
  orderId       String
  status        PrintStatus @default(PENDING)
  attempts      Int         @default(0)
  lastError     String?
  createdAt     DateTime    @default(now())
  nextAttemptAt DateTime    @default(now())
  printedAt     DateTime?

  order Orders @relation(fields: [orderId], references: [id])
}

model OrderItems {
  id         String  @id @default(uuid())
  amount     Int
  unitPrice  Decimal
  menuItemId String
  orderId    String

  menuItem MenuItems @relation(fields: [menuItemId], references: [id])
  order    Orders    @relation(fields: [orderId], references: [id])
}

model Payments {
  id        String      @id @default(uuid())
  amount    Decimal
  createdAt DateTime    @default(now())
  sessionId String
  paymentTo SessionType

  session Sessions @relation(fields: [sessionId], references: [id])
}
